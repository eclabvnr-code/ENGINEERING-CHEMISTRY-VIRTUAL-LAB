      1: [
        { label: "Step 1", text: "Weigh the given MgSO₄·7H₂O salt using analytical balance.", fn: executeWeighingAction },
        { label: "Step 2", text: "Transfer into a clean 100 mL volumetric flask.", fn: executeTransferToFlask },
