    /* Titration Flow Control */
    function setFlowRate(rate) {
      clearInterval(labState.flowInterval);
      labState.flowInterval = null;
      labState.flowRate = rate;

      document.getElementById('btn-flow-off').classList.toggle('active', rate === 0);
      document.getElementById('btn-flow-slow').classList.toggle('active', rate === 1);
      document.getElementById('btn-flow-fast').classList.toggle('active', rate === 2);

      if (rate === 1) {
        labState.flowInterval = setInterval(() => {
          advanceBurette(0.05);
          animateDrip();
        }, 280);
      } else if (rate === 2) {
        labState.flowInterval = setInterval(() => {
          advanceBurette(0.10);
        }, 80);
      }
      updateVisuals();
    }

    function dispenseDrop() {
      advanceBurette(0.05);
      animateDrip();
      updateVisuals();
    }

    function animateDrip() {
      playTone('drop');
      const drop = document.getElementById('droplet-node');
      drop.setAttribute('opacity', 0.9);
      let y = 291;
      drop.setAttribute('cy', y);
      const anim = setInterval(() => {
        y += 3;
        drop.setAttribute('cy', y);
        // Slightly stretch the drop while falling to make the stream legible.
        drop.setAttribute('ry', y < 318 ? 4.8 : 5.6);
        if (y >= 335) {
          clearInterval(anim);
          drop.setAttribute('opacity', 0);
          drop.setAttribute('ry', 4.2);
        }
      }, 28);
    }

    function advanceBurette(amount) {
      if (labState.buretteVolume >= 50.0) {
        setFlowRate(0);
        return;
      }

      const prev = labState.buretteVolume;
      labState.buretteVolume = Math.min(50.0, labState.buretteVolume + amount);

      const V_eq = labState.stage === 2 ? labState.V1_true : (labState.V2_true);
      if (prev < V_eq && labState.buretteVolume >= V_eq && labState.flaskEBT > 0) {
        playTone('chime');
      }
      updateVisuals();
    }

    function refillBurette() {
      executeRefillBuretteAnimation();
    }

    function toggleStirring(forceState) {
      labState.isStirring = forceState !== undefined ? forceState : !labState.isStirring;
      const btn = document.getElementById('stir-btn');
      btn.classList.toggle('active', labState.isStirring);
      btn.innerText = labState.isStirring ? '↻ Swirl Flask: ON' : '↻ Swirl Flask: OFF';
      const conical = document.getElementById('obj-conical-movable');
      if (labState.swirlInterval) {
        clearInterval(labState.swirlInterval);
        labState.swirlInterval = null;
      }
      if (labState.isStirring) {
        // A small clockwise orbital shake with gentle wrist-like rocking, not a magnetic stirrer spin.
        conical.style.transition = 'none';
        labState.swirlInterval = setInterval(() => {
          if (!labState.isStirring) return;
          labState.swirlPhase = (labState.swirlPhase + 0.16) % (Math.PI * 2);
          const baseX = labState.conicalUnderBurette ? 600 : 400;
          const baseY = labState.conicalUnderBurette ? 282 : 285;
          const x = baseX + 2.1 * Math.cos(labState.swirlPhase);
          const y = baseY + 1.15 * Math.sin(labState.swirlPhase);
          const angle = 4.5 * Math.sin(labState.swirlPhase);
          conical.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${angle.toFixed(2)} 30 10)`);
        }, 35);
      } else {
        const baseX = labState.conicalUnderBurette ? 600 : 400;
        const baseY = labState.conicalUnderBurette ? 282 : 285;
        conical.setAttribute('transform', `translate(${baseX} ${baseY})`);
        conical.style.transition = '';
      }
      updateVisuals();
    }

    function washFlask() {
      if (labState.isStirring) toggleStirring(false);
      else if (labState.swirlInterval) { clearInterval(labState.swirlInterval); labState.swirlInterval = null; }
      labState.flaskSampleVol = 0;
      labState.flaskSampleType = null;
      labState.flaskBufferVol = 0;
      labState.flaskEBT = 0;
      labState.conicalUnderBurette = false;
      document.getElementById('obj-conical-movable').setAttribute('transform', 'translate(400, 285)');
      if (labState.flowRate > 0) setFlowRate(0);
      updateVisuals();
    }

    function switchStage(stageNum) {
      if (labState.isAnimating) return;
      if (labState.flowRate > 0) setFlowRate(0);
      labState.stage = stageNum;

      for (let i = 1; i <= 3; i++) {
        document.getElementById(`btn-stg-${i}`).classList.toggle('active', i === stageNum);
      }

      const label = document.getElementById('beaker-sample-tag');
      if (stageNum === 2) label.textContent = "Std MgSO₄";
      else if (stageNum === 3) label.textContent = "Hard Water";

      washFlask();
      renderGuideSteps();
      updateVisuals();
    }

    function isMobileFocusActive() {
      const mode = document.documentElement.getAttribute('data-layout-mode') || 'auto';
      return mode === 'mobile' || (mode === 'auto' && window.matchMedia('(max-width: 700px)').matches);
    }

    function renderGuideSteps() {
      const container = document.getElementById('protocol-steps');
      const list = stageGuides[labState.stage];
      const cur = labState.stepIndex[labState.stage];

      if (isMobileFocusActive()) {
        const progressText = cur < list.length
          ? `STEP ${cur + 1} OF ${list.length}`
          : 'ALL STEPS COMPLETED';

        if (cur >= list.length) {
          container.innerHTML = `
            <div class="mobile-step-progress">${progressText}</div>
            <div class="step-card done active mobile-current-step">
              <div class="step-top"><span>Stage completed</span><span>✓ Done</span></div>
              <div class="step-desc">All operations in this stage have been completed. Switch to the next stage above or record your reading into the Logbook.</div>
            </div>
          `;
          return;
        }

        const item = list[cur];
        container.innerHTML = `
          <div class="mobile-step-progress">${progressText}</div>
          <div class="step-card active mobile-current-step">
            <div class="step-top">
              <span>${item.label}</span>
              <span>● In Progress</span>
            </div>
            <div class="step-desc">${item.text}</div>
            <button class="step-exec-btn" onclick="stageGuides[${labState.stage}][${cur}].fn()">▶ Perform Task (${item.label})</button>
          </div>
        `;
        return;
      }

      let html = '';
      list.forEach((item, idx) => {
        const isDone = idx < cur;
        const isActive = idx === cur;
        const cls = isDone ? 'step-card done' : (isActive ? 'step-card active' : 'step-card');

        html += `
          <div class="${cls}">
            <div class="step-top">
              <span>${item.label}</span>
              <span>${isDone ? '✓ Done' : (isActive ? '● In Progress' : '')}</span>
            </div>
            <div class="step-desc">${item.text}</div>
            ${isActive ? `<button class="step-exec-btn" onclick="stageGuides[${labState.stage}][${idx}].fn()">Perform Task</button>` : ''}
          </div>
        `;
      });
      container.innerHTML = html;
    }

    function advanceStep(idx) {
      if (labState.stepIndex[labState.stage] === idx) {
        labState.stepIndex[labState.stage]++;
        renderGuideSteps();
      }
    }

    function logCurrentTitre() {
      openModalWindow('modal-calc');
      const reading = labState.buretteVolume.toFixed(2);

      if (labState.stage === 2) {
        document.getElementById('v1-val').value = reading;
        const titreNum = parseFloat(reading);
        if (titreNum > 0) {
          const mEDTA = (0.01 * 20.0 / titreNum).toFixed(4);
          document.getElementById('calc-m-edta').value = mEDTA;
        }
      } else if (labState.stage === 3) {
        document.getElementById('v2-val').value = reading;
      }
    }

    function populateSimulatedData() {
      document.getElementById('prep-weight').value = "0.2464";
      document.getElementById('prep-molarity').value = "0.0100";

      document.getElementById('v1-val').value = labState.V1_true.toFixed(2);
      const mEDTA = (0.01 * 20.0 / labState.V1_true);
      document.getElementById('calc-m-edta').value = mEDTA.toFixed(4);

      document.getElementById('v2-val').value = labState.V2_true.toFixed(2);

      const tot = labState.V2_true * mEDTA * 5000;
      document.getElementById('calc-total').value = tot.toFixed(1);
    }

    function verifyCalculations() {
      const banner = document.getElementById('verify-banner');
      const v1 = parseFloat(document.getElementById('v1-val').value);
      const v2 = parseFloat(document.getElementById('v2-val').value);

      const mEDTA_in = parseFloat(document.getElementById('calc-m-edta').value);
      const totIn = parseFloat(document.getElementById('calc-total').value);

      if (isNaN(v1) || isNaN(v2) || isNaN(mEDTA_in) || isNaN(totIn)) {
        banner.style.display = 'block';
        banner.style.background = 'rgba(245, 158, 11, 0.2)';
        banner.style.border = '1px solid var(--accent-amber)';
        banner.style.color = '#fde68a';
        banner.innerHTML = "⚠️ Please complete all entries in the tables before verifying.";
        return;
      }

      const trueMEDTA = 0.01 * 20.0 / v1;
      const trueTot = v2 * trueMEDTA * 5000;

      if (Math.abs(totIn - trueTot) <= 5.0 && Math.abs(mEDTA_in - trueMEDTA) <= 0.0005) {
        banner.style.display = 'block';
        banner.style.background = 'rgba(16, 185, 129, 0.2)';
        banner.style.border = '1px solid var(--accent-emerald)';
        banner.style.color = '#6ee7b7';
        banner.innerHTML = `
          <strong>✓ Calculations Verified!</strong> Values match stoichiometry within ±1%:<br>
          • Molarity of EDTA (M_EDTA): <strong>${mEDTA_in.toFixed(4)} M</strong><br>
          • Total Hardness: <strong>${totIn.toFixed(1)} ppm</strong> (Expected: ${trueTot.toFixed(1)} ppm)
        `;
      } else {
        banner.style.display = 'block';
        banner.style.background = 'rgba(244, 63, 94, 0.2)';
        banner.style.border = '1px solid var(--accent-rose)';
        banner.style.color = '#fca5a5';
        banner.innerHTML = `
          <strong>Calculation Discrepancy:</strong> Check formula: Total Hardness = V₂ × M_EDTA × 5000 = ${trueTot.toFixed(1)} ppm.
        `;
      }
    }

    function openModalWindow(id) {
      document.getElementById(id).classList.add('open');
    }

    function closeModalWindow(id) {
      document.getElementById(id).classList.remove('open');
    }

    document.querySelectorAll('.modal-backdrop').forEach(m => {
      m.addEventListener('click', (e) => {
        if (e.target === m) m.classList.remove('open');
      });
    });

    /* ================= LAYOUT MODE (AUTO / DESKTOP / MOBILE) & FULLSCREEN ================= */
    let layoutMode = 'auto';

    function setLayoutMode(mode) {
      layoutMode = mode;
      document.documentElement.setAttribute('data-layout-mode', mode);
      document.body.classList.toggle('layout-desktop', mode === 'desktop');
      document.body.classList.toggle('layout-mobile', mode === 'mobile');
      document.querySelectorAll('.mode-btn[data-mode]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.mode === mode);
      });
      renderGuideSteps();
      window.dispatchEvent(new Event('resize'));
    }

    async function toggleFullscreen() {
      const target = document.documentElement;
      try {
        if (!document.fullscreenElement && !document.webkitFullscreenElement) {
          if (target.requestFullscreen) await target.requestFullscreen();
          else if (target.webkitRequestFullscreen) target.webkitRequestFullscreen();
        } else {
          if (document.exitFullscreen) await document.exitFullscreen();
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        }
      } catch (e) {
        alert('Full-screen mode is not available in this browser. Try Chrome.');
      }
    }

    function updateFullscreenButton() {
      const active = !!(document.fullscreenElement || document.webkitFullscreenElement);
      const b = document.getElementById('fullscreenBtn');
      if (b) b.textContent = active ? '⤢ Exit full screen' : '⛶ Full screen';
    }

    document.addEventListener('fullscreenchange', updateFullscreenButton);
    document.addEventListener('webkitfullscreenchange', updateFullscreenButton);

    const mobileMq = window.matchMedia('(max-width: 700px)');
    if (mobileMq && typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', () => {
        if (layoutMode === 'auto') renderGuideSteps();
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      setLayoutMode('auto');
      renderGuideSteps();
      updateVisuals();
    });
  </script>
</body>
</html>
