<!DOCTYPE html>
<html lang="en" data-layout-mode="auto">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Engineering Chemistry Lab — Physical Action EDTA Titration Suite</title>
  <style>
    :root {
      --bg-space: #0b1120;
      --panel-bg: rgba(15, 23, 42, 0.95);
      --panel-border: rgba(255, 255, 255, 0.12);
      --accent-cyan: #38bdf8;
      --accent-blue: #0284c7;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    html, body {
      height: 100vh;
      max-height: 100vh;
      width: 100vw;
      background-color: var(--bg-space);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      user-select: none;
    }

    header.lab-navbar {
      height: 44px;
      min-height: 44px;
      max-height: 44px;
      background: rgba(15, 23, 42, 0.98);
      border-bottom: 1px solid var(--panel-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      z-index: 50;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-badge {
      width: 26px;
      height: 26px;
      border-radius: 6px;
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.85rem;
    }

    .brand-title h1 {
      font-size: 0.85rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.1;
    }

    .brand-title p {
      font-size: 0.62rem;
      color: var(--accent-cyan);
    }

    .stage-nav {
      display: flex;
      background: rgba(30, 41, 59, 0.7);
      padding: 2px;
      border-radius: 6px;
      border: 1px solid var(--panel-border);
      gap: 2px;
    }

    .stage-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 4px 9px;
      font-size: 0.7rem;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .stage-btn.active {
      background: var(--accent-blue);
      color: #fff;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-nav {
      background: #1e293b;
      border: 1px solid var(--panel-border);
      color: var(--text-main);
      padding: 4px 10px;
      border-radius: 5px;
      font-size: 0.7rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .btn-nav:hover {
      border-color: var(--accent-cyan);
      background: #334155;
    }

    .btn-nav.primary {
      background: var(--accent-blue);
      border-color: var(--accent-cyan);
    }

    .lab-workspace {
      flex: 1;
      height: calc(100vh - 44px);
      max-height: calc(100vh - 44px);
      min-height: 0;
      display: grid;
      grid-template-columns: 1fr 310px;
      position: relative;
      overflow: hidden;
    }

    main.workbench-stage {
      position: relative;
      height: 100%;
      min-height: 0;
      background: #090e17;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .svg-viewport-wrapper {
      flex: 1;
      min-height: 0;
      width: 100%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #apparatus-svg {
      width: 100%;
      height: 100%;
      max-height: 100%;
      display: block;
    }

    .dynamic-apparatus {
      cursor: pointer;
      transition: transform 0.85s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
    }
    .dynamic-apparatus:hover {
      filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.9));
    }
    #flask-vortex {
      stroke-dasharray: 5 3;
      animation: vortex-flow 0.8s linear infinite;
      filter: drop-shadow(0 0 2px rgba(255,255,255,0.65));
    }
    @keyframes vortex-flow { to { stroke-dashoffset: -16; } }
    #flask-glass-highlights { pointer-events: none; }

    .workbench-controls {
      height: 40px;
      min-height: 40px;
      background: rgba(15, 23, 42, 0.96);
      border-top: 1px solid var(--panel-border);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 10px;
      z-index: 30;
    }

    .btn-ctrl {
      background: #1e293b;
      color: var(--text-main);
      border: 1px solid #334155;
      padding: 4px 9px;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      transition: all 0.15s;
    }

    .btn-ctrl:hover {
      background: #334155;
      border-color: var(--accent-cyan);
    }

    .btn-ctrl.active {
      background: var(--accent-blue);
      border-color: var(--accent-cyan);
      color: #fff;
    }

    aside.guide-panel {
      background: var(--panel-bg);
      border-left: 1px solid var(--panel-border);
      display: flex;
      flex-direction: column;
      height: 100%;
      max-height: 100%;
      min-height: 0;
      overflow: hidden;
      z-index: 20;
    }

    .panel-head {
      padding: 8px 12px;
      border-bottom: 1px solid var(--panel-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
    }

    .panel-head h2 {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--accent-cyan);
      font-weight: 700;
    }

    .protocol-scroll-box {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .step-card {
      background: rgba(30, 41, 59, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      padding: 6px 9px;
      transition: all 0.15s;
    }

    .step-card.active {
      border-color: var(--accent-cyan);
      background: rgba(2, 132, 199, 0.16);
      box-shadow: 0 2px 8px rgba(2, 132, 199, 0.25);
    }

    .step-card.done {
      border-color: rgba(16, 185, 129, 0.4);
      background: rgba(16, 185, 129, 0.08);
    }

    .step-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--accent-cyan);
      margin-bottom: 2px;
    }

    .step-card.done .step-top {
      color: var(--accent-emerald);
    }

    .step-desc {
      font-size: 0.72rem;
      color: #f1f5f9;
      line-height: 1.35;
    }

    .step-exec-btn {
      margin-top: 5px;
      width: 100%;
      background: #1e293b;
      border: 1px solid #475569;
      color: #fff;
      padding: 4px 6px;
      border-radius: 4px;
      font-size: 0.68rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .step-exec-btn:hover {
      background: var(--accent-blue);
      border-color: var(--accent-cyan);
    }

    .telemetry-card {
      margin: 6px 10px;
      background: #090e1a;
      border: 1px solid var(--panel-border);
      border-radius: 6px;
      padding: 6px 8px;
      flex-shrink: 0;
    }

    .telemetry-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 2.5px 0;
      font-size: 0.68rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .telemetry-row:last-child {
      border-bottom: none;
    }

    .telemetry-label {
      color: var(--text-muted);
    }

    .telemetry-val {
      font-family: monospace;
      font-weight: 700;
      color: #f8fafc;
    }

    .swatch-circle {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.4);
      display: inline-block;
      margin-right: 3px;
      vertical-align: middle;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.85);
      backdrop-filter: blur(8px);
      z-index: 100;
      display: none;
      place-items: center;
      padding: 16px;
    }

    .modal-backdrop.open {
      display: grid;
    }

    .modal-window {
      background: #0f172a;
      border: 1px solid var(--panel-border);
      border-radius: 8px;
      width: 100%;
      max-width: 780px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8);
    }

    .modal-head {
      padding: 10px 16px;
      border-bottom: 1px solid var(--panel-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(30, 41, 59, 0.4);
    }

    .modal-head h3 {
      font-size: 0.9rem;
      font-weight: 700;
      color: #fff;
    }

    .btn-close-modal {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.2rem;
      cursor: pointer;
    }

    .modal-body {
      padding: 14px 18px;
      overflow-y: auto;
      font-size: 0.78rem;
      color: #cbd5e1;
      line-height: 1.5;
    }

    .chem-eq-card {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 5px;
      padding: 6px 10px;
      margin: 6px 0;
      font-family: monospace;
      color: #e0f2fe;
    }

    .obs-table {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0;
      font-size: 0.74rem;
    }

    .obs-table th, .obs-table td {
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 5px 6px;
      text-align: center;
    }

    .obs-table th {
      background: rgba(30, 41, 59, 0.8);
      color: var(--accent-cyan);
    }

    .obs-table input {
      width: 76px;
      background: #1e293b;
      border: 1px solid #475569;
      color: #fff;
      padding: 2px 4px;
      border-radius: 3px;
      text-align: center;
      font-weight: 700;
    }
  
    /* ================= HEADER LAYOUT MODE & FULLSCREEN CONTROLS ================= */
    .header-right-cluster {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .mode-selector {
      display: flex;
      gap: 3px;
      padding: 2px;
      border: 1px solid #334155;
      border-radius: 7px;
      background: #111c30;
    }

    .mode-btn {
      border: 1px solid transparent;
      background: transparent;
      color: #cbd5e1;
      padding: 4px 8px;
      border-radius: 5px;
      font-weight: 700;
      font-size: 0.68rem;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s;
    }

    .mode-btn:hover {
      background: #1e293b;
      color: #fff;
    }

    .mode-btn.active {
      background: #0284c7;
      border-color: #38bdf8;
      color: #fff;
    }

    .fullscreen-btn {
      border: 1px solid #38bdf8;
      background: #075985;
      color: #fff;
      padding: 4px 9px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.68rem;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s;
    }

    .fullscreen-btn:hover {
      background: #0284c7;
    }

    button:focus-visible {
      outline: 2px solid #7dd3fc;
      outline-offset: 2px;
    }

    :fullscreen {
      background: #0b1120;
    }

    /* ================= MOBILE ONE-STEP FOCUS & RESPONSIVE MODES ================= */
    .mobile-step-progress {
      color: #38bdf8;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 3px 2px;
    }

    .mobile-current-step {
      padding: 12px 13px !important;
      border-width: 1px !important;
    }

    .mobile-current-step .step-desc {
      font-size: 0.9rem !important;
      line-height: 1.45 !important;
    }

    .mobile-current-step .step-exec-btn {
      min-height: 42px !important;
      font-size: 0.82rem !important;
      margin-top: 8px !important;
    }

    @media (max-width: 1240px) {
      html[data-layout-mode="auto"] header.lab-navbar {
        height: auto;
        min-height: 44px;
        max-height: none;
        flex-wrap: wrap;
        gap: 6px;
        padding: 7px 12px;
      }
      html[data-layout-mode="auto"] .lab-workspace {
        height: calc(100vh - 80px);
        max-height: calc(100vh - 80px);
      }
    }

    @media (max-width: 700px) {
      html[data-layout-mode="auto"],
      html[data-layout-mode="mobile"] {
        height: auto !important;
        min-height: 100% !important;
        max-height: none !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
      }

      html[data-layout-mode="auto"] body,
      html[data-layout-mode="mobile"] body {
        height: auto !important;
        min-height: 100% !important;
        max-height: none !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
      }

      html[data-layout-mode="auto"] header.lab-navbar,
      html[data-layout-mode="mobile"] header.lab-navbar {
        height: auto !important;
        max-height: none !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 7px !important;
        padding: 8px 10px !important;
      }

      html[data-layout-mode="auto"] .stage-nav,
      html[data-layout-mode="mobile"] .stage-nav {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        width: 100% !important;
        gap: 3px !important;
      }

      html[data-layout-mode="auto"] .stage-btn,
      html[data-layout-mode="mobile"] .stage-btn {
        white-space: normal !important;
        line-height: 1.2 !important;
        padding: 6px 4px !important;
        font-size: 0.68rem !important;
        text-align: center !important;
      }

      html[data-layout-mode="auto"] .header-right-cluster,
      html[data-layout-mode="mobile"] .header-right-cluster {
        justify-content: space-between !important;
        width: 100% !important;
        gap: 6px !important;
      }

      html[data-layout-mode="auto"] .nav-actions,
      html[data-layout-mode="mobile"] .nav-actions {
        flex-wrap: wrap !important;
        gap: 4px !important;
      }

      html[data-layout-mode="auto"] .lab-workspace,
      html[data-layout-mode="mobile"] .lab-workspace {
        display: flex !important;
        flex-direction: column !important;
        height: auto !important;
        min-height: 100% !important;
        max-height: none !important;
        overflow: visible !important;
        align-items: stretch !important;
      }

      html[data-layout-mode="auto"] main.workbench-stage,
      html[data-layout-mode="mobile"] main.workbench-stage {
        display: flex !important;
        flex-direction: column !important;
        position: static !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
        flex: 0 0 auto !important;
      }

      html[data-layout-mode="auto"] .svg-viewport-wrapper,
      html[data-layout-mode="mobile"] .svg-viewport-wrapper {
        position: sticky !important;
        top: 0 !important;
        z-index: 100 !important;
        flex: 0 0 auto !important;
        width: 100% !important;
        height: 40dvh !important;
        min-height: 230px !important;
        max-height: 360px !important;
        padding: 4px 6px !important;
        overflow: hidden !important;
        background: #090e17 !important;
        border-bottom: 1px solid rgba(56, 189, 248, 0.45) !important;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35) !important;
      }

      html[data-layout-mode="auto"] #apparatus-svg,
      html[data-layout-mode="mobile"] #apparatus-svg {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-height: 100% !important;
        object-fit: contain !important;
      }

      html[data-layout-mode="auto"] .workbench-controls,
      html[data-layout-mode="mobile"] .workbench-controls {
        position: relative !important;
        z-index: 1 !important;
        height: auto !important;
        min-height: 40px !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        padding: 8px 10px !important;
        gap: 6px !important;
      }

      html[data-layout-mode="auto"] .btn-ctrl,
      html[data-layout-mode="mobile"] .btn-ctrl {
        justify-content: center !important;
        text-align: center !important;
        padding: 6px 8px !important;
        font-size: 0.68rem !important;
      }

      html[data-layout-mode="auto"] aside.guide-panel,
      html[data-layout-mode="mobile"] aside.guide-panel {
        position: relative !important;
        z-index: 1 !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        flex: 0 0 auto !important;
        border-left: none !important;
        border-top: 1px solid var(--panel-border) !important;
      }

      html[data-layout-mode="auto"] .protocol-scroll-box,
      html[data-layout-mode="mobile"] .protocol-scroll-box {
        flex: 0 0 auto !important;
        max-height: none !important;
        overflow: visible !important;
        padding: 7px 9px !important;
      }

      html[data-layout-mode="auto"] input,
      html[data-layout-mode="mobile"] input,
      html[data-layout-mode="auto"] select,
      html[data-layout-mode="mobile"] select,
      html[data-layout-mode="auto"] textarea,
      html[data-layout-mode="mobile"] textarea {
        font-size: 16px !important;
        max-width: 100% !important;
      }

      html[data-layout-mode="auto"] button,
      html[data-layout-mode="mobile"] button {
        min-height: 38px;
      }
    }

    @media (max-width: 380px) {
      html[data-layout-mode="auto"] .svg-viewport-wrapper,
      html[data-layout-mode="mobile"] .svg-viewport-wrapper {
        height: 32dvh !important;
        min-height: 195px !important;
        max-height: 250px !important;
      }
    }

    /* Explicit mobile mode remains mobile even on a wide desktop browser. */
    html[data-layout-mode="mobile"] {
      height: auto !important;
      min-height: 100% !important;
      max-height: none !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
    }
    html[data-layout-mode="mobile"] body {
      height: auto !important;
      min-height: 100% !important;
      max-height: none !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
    }
    html[data-layout-mode="mobile"] header.lab-navbar {
      height: auto !important;
      max-height: none !important;
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 7px !important;
      padding: 8px 10px !important;
    }
    html[data-layout-mode="mobile"] .stage-nav {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      width: 100% !important;
      gap: 3px !important;
    }
    html[data-layout-mode="mobile"] .stage-btn {
      white-space: normal !important;
      line-height: 1.2 !important;
      padding: 6px 4px !important;
      text-align: center !important;
    }
    html[data-layout-mode="mobile"] .header-right-cluster {
      justify-content: space-between !important;
      width: 100% !important;
      gap: 6px !important;
    }
    html[data-layout-mode="mobile"] .nav-actions {
      flex-wrap: wrap !important;
      gap: 4px !important;
    }
    html[data-layout-mode="mobile"] .lab-workspace {
      display: flex !important;
      flex-direction: column !important;
      height: auto !important;
      min-height: 100% !important;
      max-height: none !important;
      overflow: visible !important;
    }
    html[data-layout-mode="mobile"] main.workbench-stage {
      display: flex !important;
      flex-direction: column !important;
      position: static !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      overflow: visible !important;
      flex: 0 0 auto !important;
    }
    html[data-layout-mode="mobile"] .svg-viewport-wrapper {
      position: sticky !important;
      top: 0 !important;
      z-index: 100 !important;
      flex: 0 0 auto !important;
      width: 100% !important;
      height: 40dvh !important;
      min-height: 230px !important;
      max-height: 360px !important;
      padding: 4px 6px !important;
      overflow: hidden !important;
      background: #090e17 !important;
      border-bottom: 1px solid rgba(56, 189, 248, 0.45) !important;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35) !important;
    }
    html[data-layout-mode="mobile"] #apparatus-svg {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
    }
    html[data-layout-mode="mobile"] .workbench-controls {
      position: relative !important;
      z-index: 1 !important;
      height: auto !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      padding: 8px 10px !important;
      gap: 6px !important;
    }
    html[data-layout-mode="mobile"] .btn-ctrl {
      justify-content: center !important;
      text-align: center !important;
      padding: 6px 8px !important;
    }
    html[data-layout-mode="mobile"] aside.guide-panel {
      position: relative !important;
      z-index: 1 !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      flex: 0 0 auto !important;
      border-left: none !important;
      border-top: 1px solid var(--panel-border) !important;
    }
