      ],
      2: [
        { label: "Step 1", text: "Pipette out 20 mL of standard MgSO₄·7H₂O solution into a clean 250 mL conical flask.", fn: executePipetteSample },
        { label: "Step 2", text: "Add 2 mL of buffer (NH₄OH + NH₄Cl) to maintain the pH between 9 and 10.", fn: executeAddBuffer },
        { label: "Step 3", text: "Add 2–3 drops of Eriochrome Black T (EBT) indicator. The solution turns wine red.", fn: executeAddIndicator },
        { label: "Step 4", text: "Fill the burette with EDTA solution, adjust the level to the zero mark, and fix the burette to the stand.", fn: executeRefillBuretteAnimation },
        { label: "Step 5", text: "Titrate the MgSO₄·7H₂O solution against EDTA until the wine-red solution turns blue. Record the EDTA volume at the endpoint (V₁).", fn: executeTitrationStart }
      ],
      3: [
        { label: "Step 1", text: "Pipette out 20 mL of water sample-1 into a clean 250 mL conical flask.", fn: executePipetteSample },
        { label: "Step 2", text: "Add 2 mL of buffer (NH₄OH + NH₄Cl) to maintain pH between 9 and 10.", fn: executeAddBuffer },
        { label: "Step 3", text: "Add 2–3 drops of Eriochrome Black T (EBT) indicator. The solution turns wine red in colour.", fn: executeAddIndicator },
