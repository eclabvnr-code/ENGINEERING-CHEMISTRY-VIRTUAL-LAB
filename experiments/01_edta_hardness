    function getSolutionAppearance() {
      if (labState.flaskSampleVol === 0) {
        return { fill: 'rgba(226, 232, 240, 0)', label: 'Empty', alpha: 0 };
      }
      if (labState.flaskEBT === 0) {
        return { fill: 'rgba(224, 242, 254, 0.45)', label: 'Colorless', alpha: 0.45 };
      }

      const V_eq = labState.stage === 2 ? labState.V1_true : (labState.V2_true);
      const ratio = labState.buretteVolume / V_eq;

      let r = 153, g = 27, b = 27, label = 'Wine Red';
      if (ratio < 0.85) {
        r = 153; g = 27; b = 27;
        label = 'Wine Red';
      } else if (ratio < 0.98) {
        const factor = (ratio - 0.85) / 0.13;
        r = Math.round(153 + (95 - 153) * factor);
        g = Math.round(27 + (35 - 27) * factor);
        b = Math.round(27 + (120 - 27) * factor);
        label = 'Reddish Purple';
      } else if (ratio < 1.00) {
        r = 88; g = 40; b = 130;
        label = 'Violet';
      } else {
        r = 29; g = 78; b = 216;
        label = 'Steel Blue (Endpoint)';
      }

      return { fill: `rgb(${r}, ${g}, ${b})`, label: label, alpha: 0.85 };
    }

